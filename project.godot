config_version=5

[application]
config/name="Necromancer and Dice"
run/main_scene="res://title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
GameLanguage="*res://systems/game_language.gd"
RunSession="*res://systems/run_session.gd"
UiTypography="*res://systems/ui_typography.gd"
GameAudio="*res://systems/game_audio.gd"
QuitConfirmation="*res://systems/quit_confirmation.gd"

[internationalization]
locale/fallback="ko"

[display]
window/size/mode.windows=3
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
gl_compatibility/driver.windows="opengl3_angle"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.045, 1)
